# QuoteIQ — deployed-environment variables (placeholders only, never real values).
# The authoritative catalog — scope, sensitivity, and which are Vercel Sensitive Env Vars — is
# docs/environment-variables.md, kept one-to-one with this file and src/server/lib/config by
# src/server/tests/unit/env-catalog-sync.test.ts. Do not commit real keys, tokens, or
# connection strings.

# --- Browser-safe (exposed to the SPA through Vite import.meta.env) ---
VITE_SUPABASE_URL=<supabase-project-url>
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# --- Server-only (Vercel Sensitive Environment Variables in deployed environments) ---
# All of these are read exclusively through the typed config module (src/server/lib/config).
# Startup fails fast, naming the offending variable, if any is missing or malformed.
SUPABASE_URL=<supabase-project-url>
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
DATABASE_URL=<supavisor-transaction-pooler-connection-string-port-6543>
DIRECT_DATABASE_URL=<direct-postgres-connection-string-for-migrations-and-admin>
CRON_SECRET=<shared-secret-for-api-cron-endpoints>
INTERNAL_JOB_SECRET=<shared-secret-for-api-queue-drain>
# Salt/pepper for the Q-19 first-party API-key hashing scheme. Minimum 16 characters;
# rotating it invalidates every issued intake key.
API_KEY_PEPPER=<high-entropy-api-key-pepper-min-16-chars>

# --- Optional server settings (defaults shown; omit to accept the default) ---
# APP_ENV     one of: local | preview | staging | production   (default: local)
# NODE_ENV    one of: development | test | production          (default: development)
# LOG_LEVEL   one of: debug | info | warn | error              (default: info)
#
# STORAGE_ADAPTER              one of: supabase | fake         (default: supabase)
#   Selects the StorageAdapter binding for attachment bytes (A-6/Q-6). `supabase` is the approved
#   default and the only value permitted outside a local environment — `fake` is the in-memory test
#   seam and holds objects in process memory, so composition REFUSES it in preview/staging/production.
#   An S3/MinIO-compatible adapter can be added as a further value without touching domain code.
# STORAGE_ATTACHMENTS_BUCKET   private bucket name             (default: quote-attachments)
#   Provisioned by supabase/migrations/*_storage_buckets.sql. Must stay private: attachment access is
#   exclusively through short-lived signed URLs issued server-side after authorization (A-7).
#
# Deliberately NOT in this catalog:
#   SUPABASE_JWT_SECRET  — token verification uses asymmetric signing keys (A-10).
#   ERROR_TRACKING_DSN   — error tracking is disabled for MVP (Q-13).
