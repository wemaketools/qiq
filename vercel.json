{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run typecheck && npm run build:ui",
  "outputDirectory": "src/ui/dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/v1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/v1/index.ts": {
      "maxDuration": 30
    },
    "api/cron/*.ts": {
      "maxDuration": 60
    },
    "api/queue/*.ts": {
      "maxDuration": 60
    }
  }
}
