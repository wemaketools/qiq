# QuoteIQ — local development environment (LOCAL DEVELOPMENT VALUES ONLY).
#
# Copy to .env.local (git-ignored):    cp .env.local.example .env.local
#
# Every value below belongs to the Supabase stack running on your own machine via Docker.
# The anon and service-role keys are the well-known fixed keys that the Supabase CLI prints
# for every local project — they are LOCAL-DEVELOPMENT-ONLY. They are not secrets, they grant
# nothing outside your machine, and they must never be treated as, or copied into, the
# configuration of a deployed environment. Deployed values are documented separately in
# .env.example / docs/environment-variables.md (T-042) and live in Vercel/Supabase env config.
#
# Print the current values for this machine at any time with:
#     npx supabase status
# The keys are stable across `supabase start` / `db reset`, so you normally paste them once.

# --- Browser-safe (exposed to the SPA through Vite import.meta.env) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local-anon-key-from-`npx supabase status`>

# --- Server-only. Never expose these to the browser or import them into SPA code. ---
# Read exclusively through the typed config module (src/server/lib/config); startup fails fast
# and names the offending variable if any of these is missing or malformed.
#
# The server reads its own SUPABASE_URL/SUPABASE_ANON_KEY (used for Supabase Auth token
# verification) rather than the VITE_-prefixed browser values above.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<local-anon-key-from-`npx supabase status`>
# The service-role key bypasses RLS and drives the Auth Admin API (user provisioning, T-017).
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-from-`npx supabase status`>

# Local Postgres. Substitute <local-db-password> with the local stack's database password,
# which is `postgres` (printed in full by `npx supabase status` as DB_URL). It is written as a
# placeholder here because this repository forbids any committed example file from containing
# an inline connection-string password, local or not.
#
# The local stack's connection pooler is disabled by default ([db.pooler] in
# supabase/config.toml), so both variables point at the direct 54322 port. Deployed
# environments split these: DATABASE_URL uses the Supavisor transaction pooler (port 6543)
# for serverless runtime traffic, DIRECT_DATABASE_URL is used for migrations and admin work.
DATABASE_URL=postgresql://postgres:<local-db-password>@127.0.0.1:54322/postgres
DIRECT_DATABASE_URL=postgresql://postgres:<local-db-password>@127.0.0.1:54322/postgres

# Shared secrets guarding the cron and queue-drain endpoints (T-031). Any non-empty string
# works locally; deployed environments must use generated high-entropy values.
CRON_SECRET=<local-only-cron-secret>
INTERNAL_JOB_SECRET=<local-only-job-secret>

# Salt/pepper for the Q-19 first-party API-key hashing scheme (minimum 16 characters).
API_KEY_PEPPER=<local-only-api-key-pepper-min-16-chars>

# --- Optional server settings (defaults shown; uncomment to override) ---
# APP_ENV defaults to `local`, NODE_ENV to `development`, LOG_LEVEL to `info`.
# LOG_LEVEL=debug is useful when working on request/job logging.
#
# STORAGE_ADAPTER defaults to `supabase`; `fake` is the in-memory test seam, permitted only in a
#   local environment (composition refuses it in preview/staging/production).
# STORAGE_ATTACHMENTS_BUCKET defaults to `quote-attachments` (the private bucket from migrations).
